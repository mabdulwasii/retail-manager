# Cloud Portal Configuration
# This environment file is used when building the cloud portal frontend

# API Configuration
VITE_API_BASE_URL=https://api.retailhq.app/api

# Keycloak Configuration
VITE_KEYCLOAK_URL=https://api.retailhq.app/auth
VITE_KEYCLOAK_REALM=shop-manager
VITE_KEYCLOAK_CLIENT_ID=shop-manager-frontend

# Environment
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# Authentication Mode
VITE_AUTH_MODE=keycloak

# Cloud Mode (enables cloud-specific features)
VITE_CLOUD_MODE=true
