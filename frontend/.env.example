# API Configuration
VITE_API_BASE_URL=http://localhost:8081/api

# Keycloak Configuration
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=shop-manager
VITE_KEYCLOAK_CLIENT_ID=shop-manager-frontend

# Environment
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# Authentication Mode (keycloak | embedded)
# - keycloak: Use Keycloak SSO (default for cloud deployments)
# - embedded: Use embedded JWT authentication (standalone JAR mode)
VITE_AUTH_MODE=keycloak

# Cloud Mode (true | false)
# - true: Enable cloud portal features (tenants, analytics, subscriptions)
# - false: Local shop mode (default)
# Note: Auto-detects from hostname in production (cloud.retailhq.app)
VITE_CLOUD_MODE=false