# Shop Manager Environment Variables Template
# Copy this file to .env and configure for your environment

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Server Configuration
SERVER_PORT=8081

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/shopdb
SPRING_DATASOURCE_USERNAME=shop
SPRING_DATASOURCE_PASSWORD=shop

# Keycloak Configuration
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/shop-manager
KEYCLOAK_JWK_SET_URI=http://localhost:8080/realms/shop-manager/protocol/openid-connect/certs
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=shop-manager
KEYCLOAK_CLIENT_ID=shop-manager-backend
KEYCLOAK_CLIENT_SECRET=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# MinIO/S3 Configuration for Backups
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=shop-manager-backups

# Feature Flags
FEATURE_INVESTMENT_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true
FEATURE_FRAUD_ENABLED=false
FEATURE_MULTI_CURRENCY=false
FEATURE_BARCODE_SCANNING=true
FEATURE_LOYALTY_PROGRAM=false

# Business Configuration
APP_BUSINESS_DEFAULT_CURRENCY=USD
APP_BUSINESS_DEFAULT_TAX_RATE=0.075
APP_BUSINESS_MAX_RETURN_DAYS=30
APP_BUSINESS_MIN_REORDER_POINT=10

# Inventory Configuration
APP_INVENTORY_LOW_STOCK_THRESHOLD=10
APP_INVENTORY_EXPIRY_WARNING_DAYS=30
APP_INVENTORY_AUTO_REORDER_ENABLED=false
APP_INVENTORY_STOCK_CHECK_INTERVAL_HOURS=6

# Security Configuration
SECURITY_TENANT_ISOLATION=true
SECURITY_PERMISSION_CACHING=true
SECURITY_SESSION_TIMEOUT_MINUTES=30
APP_SECURITY_MAX_LOGIN_ATTEMPTS=5
APP_SECURITY_ACCOUNT_LOCK_DURATION_MINUTES=30
APP_SECURITY_PASSWORD_MIN_LENGTH=8
APP_SECURITY_JWT_EXPIRATION_HOURS=24

# Audit Configuration
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=90
AUDIT_LOG_ENTITY_CHANGES=true
AUDIT_LOG_SECURITY_EVENTS=true
AUDIT_LOG_API_REQUESTS=false

# Backup Configuration
STORAGE_BACKUP_PATH=/var/shop-manager/backups
APP_BACKUP_RETENTION_DAYS=30
APP_BACKUP_MAX_FILE_SIZE_MB=500
APP_BACKUP_COMPRESSION_ENABLED=true
APP_BACKUP_ENCRYPTION_ALGORITHM=AES256
APP_BACKUP_SCHEDULE_CRON=0 0 2 * * SUN
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_SALT=

# Cache Configuration
APP_CACHE_DEFAULT_TTL_MINUTES=60
APP_CACHE_ANALYTICS_TTL_HOURS=1

# Notification Configuration
APP_NOTIFICATION_EMAIL_ENABLED=true
APP_NOTIFICATION_SMS_ENABLED=false
APP_NOTIFICATION_LOW_STOCK_ALERT_ENABLED=true

# Email Configuration (if email notifications enabled)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# Upload Configuration
APP_UPLOAD_MAX_FILE_SIZE_MB=10
APP_UPLOAD_ALLOWED_EXTENSIONS=csv,xlsx,xls,pdf,jpg,jpeg,png
APP_UPLOAD_TEMP_DIRECTORY=/tmp/shop-manager/uploads

# Performance Configuration
APP_PERFORMANCE_CONNECTION_POOL_SIZE=10
APP_PERFORMANCE_QUERY_TIMEOUT_SECONDS=30
APP_PERFORMANCE_BULK_BATCH_SIZE=1000

# Report Configuration
APP_REPORTS_DEFAULT_FORMAT=PDF
APP_REPORTS_GENERATION_TIMEOUT_MINUTES=5

# Integration Configuration
APP_INTEGRATION_RETRY_ATTEMPTS=3
APP_INTEGRATION_RETRY_DELAY_MS=1000
APP_INTEGRATION_TIMEOUT_SECONDS=30

# System Configuration
APP_SYSTEM_DEFAULT_TIMEZONE=UTC
APP_SYSTEM_DEFAULT_LOCALE=en_US
APP_SYSTEM_MAINTENANCE_MODE=false
APP_SYSTEM_DEBUG_MODE=false

# Monitoring Configuration
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true

# Scheduler Configuration
SCHEDULER_PROFIT_DISTRIBUTION=true
SCHEDULER_MONTHLY_DAY=1
SCHEDULER_MONTHLY_HOUR=2
SCHEDULER_CACHE_CLEANUP=true
SCHEDULER_CACHE_CLEANUP_INTERVAL=6
SCHEDULER_AUDIT_CLEANUP=true
SCHEDULER_AUDIT_CLEANUP_INTERVAL=7

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_PRINCELY_SHOPMANAGER=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_SECURITY=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO

# JWT Secrets (Generate strong random values for production)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Redis Configuration (if using Redis for caching)
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# SonarQube Configuration
SONAR_HOST_URL=http://localhost:9090
SONAR_TOKEN=

# Production-specific (uncomment for production)
# SECURITY_REQUIRE_HTTPS=true
# SECURITY_HSTS_ENABLED=true
# SERVER_COMPRESSION_ENABLED=true
# SERVER_HTTP2_ENABLED=true