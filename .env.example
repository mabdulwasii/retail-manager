# Shop Manager Environment Configuration
# Copy this file to .env and update with your secure passwords
# IMPORTANT: Never commit the .env file to version control

# =============================================================================
# SECURITY NOTICE
# =============================================================================
# Generate strong passwords using a password manager or tools like:
# - openssl rand -base64 32
# - pwgen -s 32 1
# - Online generators with high entropy
#
# Password Requirements:
# - Minimum 16 characters
# - Mix of uppercase, lowercase, numbers, and special characters
# - Avoid dictionary words and common patterns
# =============================================================================

# PostgreSQL Main Database
POSTGRES_USER=shop
POSTGRES_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE
POSTGRES_DB=shopdb

# Keycloak Configuration
KC_DB_USERNAME=shop
KC_DB_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=YOUR_SECURE_KEYCLOAK_ADMIN_PASSWORD_HERE

# MinIO Object Storage
MINIO_ROOT_USER=shopmanager
MINIO_ROOT_PASSWORD=YOUR_SECURE_MINIO_PASSWORD_HERE

# SonarQube Configuration
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=YOUR_SECURE_SONAR_DB_PASSWORD_HERE
SONAR_DB_NAME=sonar

# =============================================================================
# EXAMPLE SECURE PASSWORDS (REPLACE WITH YOUR OWN)
# =============================================================================
# These are examples of strong passwords - DO NOT use these in production
# Generate your own unique passwords for each service

# Example PostgreSQL passwords:
# POSTGRES_PASSWORD=xK9mP2$vL8qR7@nF5tW3zE6yU1bN4cA0
# KC_DB_PASSWORD=xK9mP2$vL8qR7@nF5tW3zE6yU1bN4cA0

# Example Keycloak admin password:
# KEYCLOAK_ADMIN_PASSWORD=B7@mQ4vK2$rP9wE6zF8xL3nT5cY1uA0s

# Example MinIO passwords:
# MINIO_ROOT_PASSWORD=N5tR8@qW2vE7mP1kL4xF9zC6yB3uA0sG

# Example SonarQube password:
# SONAR_DB_PASSWORD=F3xL8@tP5qW2vE9mK7zR4nY6uC1bA0sG

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================
# For local development, you can use simpler passwords, but still secure:

# Development PostgreSQL (still secure but easier to remember)
# POSTGRES_PASSWORD=DevShop@2024!SecureDB
# KC_DB_PASSWORD=DevShop@2024!SecureDB

# Development Keycloak
# KEYCLOAK_ADMIN_PASSWORD=DevAdmin@2024!Secure

# Development MinIO
# MINIO_ROOT_PASSWORD=DevMinio@2024!Storage

# Development SonarQube
# SONAR_DB_PASSWORD=DevSonar@2024!Quality

# =============================================================================
# PRODUCTION SECURITY CHECKLIST
# =============================================================================
# Before deploying to production:
# 
# ✓ Generate unique passwords for each service
# ✓ Use a password manager to store and generate passwords
# ✓ Passwords should be at least 20 characters long
# ✓ Use environment-specific passwords (staging ≠ production)
# ✓ Rotate passwords regularly (quarterly recommended)
# ✓ Never use default passwords in any environment
# ✓ Monitor for security vulnerabilities in dependencies
# ✓ Enable database connection encryption (SSL/TLS)
# ✓ Limit database access to necessary services only
# ✓ Enable audit logging for all authentication attempts
#
# =============================================================================