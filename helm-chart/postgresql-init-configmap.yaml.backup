{{- if .Values.postgresql.enabled }}
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ include "shop-manager.fullname" . }}-postgresql-init
  labels:
    {{- include "shop-manager.labels" . | nindent 4 }}
    app.kubernetes.io/component: postgresql-init
data:
  init-databases.sh: |
    #!/bin/bash
    set -e

    echo "Starting database initialization..."

    # Wait for PostgreSQL to be ready
    until pg_isready -h localhost -p 5432 -U postgres; do
      echo "Waiting for PostgreSQL to be ready..."
      sleep 2
    done

    echo "PostgreSQL is ready. Creating databases and users..."

    # Create Keycloak database and user
    echo "Creating Keycloak database and user..."
    psql -v ON_ERROR_STOP=1 --username postgres <<-EOSQL
        DO \$\$
        BEGIN
            -- Create Keycloak user if it doesn't exist
            IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = 'keycloak') THEN
                CREATE USER keycloak WITH PASSWORD '${KEYCLOAK_DB_PASSWORD}';
                RAISE NOTICE 'Created keycloak user';
            ELSE
                ALTER USER keycloak WITH PASSWORD '${KEYCLOAK_DB_PASSWORD}';
                RAISE NOTICE 'Updated keycloak user password';
            END IF;

            -- Create Keycloak database if it doesn't exist
            IF NOT EXISTS (SELECT FROM pg_database WHERE datname = 'keycloak') THEN
                CREATE DATABASE keycloak OWNER keycloak;
                RAISE NOTICE 'Created keycloak database';
            ELSE
                RAISE NOTICE 'Keycloak database already exists';
            END IF;
        END
        \$\$;

        -- Grant all privileges on keycloak database to keycloak user
        GRANT ALL PRIVILEGES ON DATABASE keycloak TO keycloak;

        -- Additional permissions for keycloak user on keycloak database
        \c keycloak
        GRANT ALL ON SCHEMA public TO keycloak;
        GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO keycloak;
        GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO keycloak;
        ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON TABLES TO keycloak;
        ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON SEQUENCES TO keycloak;
EOSQL

    echo "Database initialization completed successfully!"

  check-databases.sh: |
    #!/bin/bash
    set -e

    echo "Checking database setup..."

    # Check if keycloak user exists and can connect
    if psql -h localhost -U keycloak -d keycloak -c "SELECT 1" >/dev/null 2>&1; then
        echo "✓ Keycloak user can connect to keycloak database"
    else
        echo "✗ Keycloak user cannot connect to keycloak database"
        exit 1
    fi

    # Check if shop user exists and can connect
    if psql -h localhost -U shop -d shopdb -c "SELECT 1" >/dev/null 2>&1; then
        echo "✓ Shop user can connect to shopdb database"
    else
        echo "✗ Shop user cannot connect to shopdb database"
        exit 1
    fi

    echo "All database checks passed!"
{{- end }}