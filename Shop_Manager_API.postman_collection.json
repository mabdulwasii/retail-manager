                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Test Shop\",\n    \"email\": \"test@shop.com\",\n    \"phone\": \"+1234567890\",\n    \"address\": {\n        \"street\": \"123 Main St\",\n        \"city\": \"New York\",\n        \"state\": \"NY\",\n        \"country\": \"USA\",\n        \"postalCode\": \"10001\"\n    },\n    \"tenantId\": \"default-tenant\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/shops",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "shops"
              ]
            }
          }
        }
      ]
    },
