# ============================================================================
# Shop Manager - Docker Compose Lite Configuration Template
# ============================================================================
# Copy this file to .env.lite and configure as needed
# ============================================================================

# Application Version
APP_VERSION=1.0.0

# Domain Configuration
# Custom domain for professional URLs (e.g., shop.mystore.com, shopmanager.local)
# Use 'localhost' for local-only access
# Use '.local' domain (e.g., shopmanager.local) for network discovery via mDNS/Bonjour
CUSTOM_DOMAIN=shopmanager.local
SHOP_NAME=Shop Manager

# Port Configuration
BACKEND_PORT=8081
FRONTEND_PORT=3001

# Data Directory (where PostgreSQL database and uploads are stored)
DATA_DIR=./data

# PostgreSQL Database Configuration
POSTGRES_PASSWORD=shopmanager

# JWT Authentication
# IMPORTANT: Generate a secure random secret using: openssl rand -base64 64
# DO NOT use the example below in production!
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_FROM_OPENSSL_RAND_BASE64_64

# Cloud Sync Configuration (Optional)
# Enable this to sync transaction data to a cloud instance for analytics
CLOUD_SYNC_ENABLED=false

# Cloud API endpoint (only if CLOUD_SYNC_ENABLED=true)
CLOUD_API_URL=

# API key for cloud authentication (only if CLOUD_SYNC_ENABLED=true)
CLOUD_API_KEY=

# Unique store identifier (only if CLOUD_SYNC_ENABLED=true)
STORE_ID=

# Sync schedule (cron expression, default: hourly)
# Examples:
#   0 0 * * * ?     - Every hour
#   0 */15 * * * ?  - Every 15 minutes
#   0 0 0 * * ?     - Daily at midnight
SYNC_CRON=0 0 * * * ?

# Anonymize customer PII before syncing (recommended for privacy)
ANONYMIZE_PII=false

# ============================================================================
# Advanced Configuration (Usually no need to change)
# ============================================================================

# JVM Memory Settings for Backend
# Adjust based on available system memory
# Default: 256MB min, 512MB max (suitable for 4GB+ systems)
JAVA_OPTS='-Xms256m -Xmx512m -XX:+UseG1GC'
