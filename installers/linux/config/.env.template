# ============================================================================
# Shop Manager - Embedded Mode Configuration
# ============================================================================
# This file is automatically generated during installation
# Edit these values to customize your Shop Manager installation
# ============================================================================

# Domain Configuration
# Custom domain for professional URLs (configured during installation)
# Examples: shop.mystore.com, shopmanager.local, pos.company.com
CUSTOM_DOMAIN=shopmanager.local
SHOP_NAME=Shop Manager

# Server Port (Single port for both frontend and API)
# Default: 80 (standard HTTP, no port number needed in URLs)
# Fallback: 8080 (if port 80 is occupied)
BACKEND_PORT=80

# Database Configuration (Embedded PostgreSQL)
POSTGRES_PORT=5433
POSTGRES_DATABASE=shopmanager
POSTGRES_DATA_DIR=postgres

# Storage Configuration
STORAGE_PATH=./data/uploads
MAX_FILE_SIZE=10485760

# JWT Configuration
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# mDNS Configuration
MDNS_ENABLED=true

# Cloud Sync Configuration (Optional)
CLOUD_REGISTRATION_URL=https://api.retailhq.app
CLOUD_API_KEY=
CLOUD_SYNC_REQUIRED=false
CLOUD_ALLOW_OFFLINE=true
CLOUD_SYNC_CRON='0 0 * * * ?'
CLOUD_SYNC_BATCH_SIZE=1000

# Update Notification Configuration
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_CRON='0 0 */24 * * ?'
CLOUD_API_URL=https://api.retailhq.app
GITHUB_RELEASES_URL=https://github.com/mabdulwasii/retail-manager/releases

# Bootstrap Configuration
BOOTSTRAP_TENANT_ENABLED=true
DEFAULT_TENANT_NAME=Default Organization
DEFAULT_TENANT_EMAIL=contact@retailhq.local
DEFAULT_TENANT_ADDRESS=123 Main Street
DEFAULT_TENANT_CITY=Springfield
DEFAULT_TENANT_COUNTRY=USA

BOOTSTRAP_SHOP_ENABLED=true
DEFAULT_SHOP_NAME=Main Shop
DEFAULT_SHOP_ADDRESS=123 Main Street
DEFAULT_SHOP_CITY=Springfield
DEFAULT_SHOP_COUNTRY=USA
DEFAULT_SHOP_PHONE=1-800-000-0000
DEFAULT_SHOP_EMAIL=shop@retailhq.local

BOOTSTRAP_SUPERADMIN_ENABLED=true
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@retailhq.local
SUPERADMIN_FIRSTNAME=Super
SUPERADMIN_LASTNAME=Admin
SUPERADMIN_PHONE=1-000-000-0000
SUPERADMIN_PASSWORD=changeme

# Logging
LOG_LEVEL=INFO

# Configuration Version (for automatic migration)
CONFIG_VERSION=1.0
