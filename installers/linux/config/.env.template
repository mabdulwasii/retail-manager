# ============================================================================
# Shop Manager - Linux Installation Configuration
# ============================================================================
# Location depends on installation type:
#   System: /etc/shop-manager/shop-manager.env
#   User:   ~/.shopmanager/shop-manager.env
# Edit this file to customize your Shop Manager configuration
# ============================================================================

# Port Configuration
BACKEND_PORT=8081
FRONTEND_PORT=3001

# Data Directory
# System installation: /var/lib/shop-manager/data
# User installation: ~/.shopmanager/data
DATA_DIR=/var/lib/shop-manager/data

# H2 Database Configuration
H2_PASSWORD=
H2_CONSOLE_ENABLED=false

# JWT Authentication
# IMPORTANT: Keep this secret secure!
# This value is generated automatically during installation
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET

# Cloud Sync Configuration (Optional)
# Enable this to sync transaction data to a cloud instance
CLOUD_SYNC_ENABLED=false

# Cloud API endpoint (only if CLOUD_SYNC_ENABLED=true)
CLOUD_API_URL=

# API key for cloud authentication (only if CLOUD_SYNC_ENABLED=true)
CLOUD_API_KEY=

# Unique store identifier (only if CLOUD_SYNC_ENABLED=true)
STORE_ID=

# Sync schedule (cron expression)
# Examples:
#   0 0 * * * ?     - Every hour
#   0 */15 * * * ?  - Every 15 minutes
#   0 0 0 * * ?     - Daily at midnight
SYNC_CRON='0 0 * * * ?'

# Anonymize customer PII before syncing (recommended)
ANONYMIZE_PII=false

# ============================================================================
# Advanced Configuration
# ============================================================================

# JVM Memory Settings
# Adjust based on available system memory
# Examples:
#   Low memory (1-2 GB RAM):     -Xms128m -Xmx256m
#   Normal (2-4 GB RAM):         -Xms256m -Xmx512m
#   High memory (4+ GB RAM):     -Xms512m -Xmx1g
JAVA_OPTS='-Xms256m -Xmx512m -XX:+UseG1GC'
