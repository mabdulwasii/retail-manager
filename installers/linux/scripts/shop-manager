#!/bin/bash
# ============================================================================
# Shop Manager - Linux Launcher Script
# ============================================================================
# This script launches Shop Manager on Linux
# ============================================================================

# Determine installation type
if [ -f "/opt/shop-manager/lib/shop-manager.jar" ]; then
    # System installation (via .deb or .rpm)
    APP_DIR="/opt/shop-manager"
    DATA_DIR="/var/lib/shop-manager/data"
    CONFIG_FILE="/etc/shop-manager/shop-manager.env"
    LOG_FILE="/var/lib/shop-manager/data/logs/shop-manager.log"
else
    # User installation (AppImage or manual)
    APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    DATA_DIR="$HOME/.shopmanager/data"
    CONFIG_FILE="$HOME/.shopmanager/shop-manager.env"
    LOG_FILE="$HOME/.shopmanager/data/logs/shop-manager.log"
fi

# Function to check Java installation
check_java() {
    if ! command -v java &> /dev/null; then
        echo "ERROR: Java 21 or higher is required to run Shop Manager"
        echo ""
        echo "Install Java 21:"
        echo "  Ubuntu/Debian: sudo apt-get install openjdk-21-jre"
        echo "  RHEL/Fedora:   sudo yum install java-21-openjdk"
        echo "  Or download from: https://adoptium.net/temurin/releases/?version=21"
        exit 1
    fi

    # Check Java version
    JAVA_VERSION=$(java -version 2>&1 | head -1 | cut -d'"' -f2 | cut -d'.' -f1)
    if [ "$JAVA_VERSION" -lt 21 ]; then
        echo "ERROR: Shop Manager requires Java 21 or higher"
        echo "Current version: Java $JAVA_VERSION"
        echo ""
        echo "Please upgrade Java to version 21 or higher"
        exit 1
    fi
}

# Function to load environment variables
load_env() {
    # Create config directory if needed (for user installations)
    if [[ "$CONFIG_FILE" == *"$HOME"* ]]; then
        mkdir -p "$(dirname "$CONFIG_FILE")"

        # Copy template if config doesn't exist
        if [ ! -f "$CONFIG_FILE" ]; then
            if [ -f "$APP_DIR/usr/share/shop-manager/config/.env.template" ]; then
                cp "$APP_DIR/usr/share/shop-manager/config/.env.template" "$CONFIG_FILE"
            elif [ -f "$APP_DIR/config/.env.template" ]; then
                cp "$APP_DIR/config/.env.template" "$CONFIG_FILE"
            fi

            # Generate JWT secret
            if [ -f "$CONFIG_FILE" ]; then
                JWT_SECRET=$(openssl rand -base64 64 | tr -d '\n')
                sed -i "s|JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET|JWT_SECRET=$JWT_SECRET|" "$CONFIG_FILE"
                chmod 600 "$CONFIG_FILE"
            fi
        fi
    fi

    # Load environment variables
    if [ -f "$CONFIG_FILE" ]; then
        # Check if .env is old format (missing POSTGRES_DATA_DIR)
        if ! grep -q "POSTGRES_DATA_DIR" "$CONFIG_FILE" 2>/dev/null; then
            echo ""
            echo "📦 Detected old configuration format (v0.1.30)"
            echo "   Migrating to new format with embedded PostgreSQL..."

            # Backup old config
            cp "$CONFIG_FILE" "$CONFIG_FILE.backup.$(date +%Y%m%d_%H%M%S)"
            echo "   Backed up old config to: $CONFIG_FILE.backup.*"

            # Copy new template
            if [ -f "$APP_DIR/usr/share/shop-manager/config/.env.template" ]; then
                cp "$APP_DIR/usr/share/shop-manager/config/.env.template" "$CONFIG_FILE"
            elif [ -f "$APP_DIR/config/.env.template" ]; then
                cp "$APP_DIR/config/.env.template" "$CONFIG_FILE"
            fi
            echo "   Created new configuration with PostgreSQL settings"

            # Generate new JWT secret
            JWT_SECRET=$(openssl rand -base64 64 | tr -d '\n')
            sed -i "s|JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET|JWT_SECRET=$JWT_SECRET|" "$CONFIG_FILE"

            # Set permissions
            chmod 600 "$CONFIG_FILE"
            echo "✅ Configuration upgraded to v0.1.49 format"
            echo "   NOTE: You will need to log in again with your credentials"
            echo ""
        fi

        export $(grep -v '^#' "$CONFIG_FILE" | xargs)

        # Migrate old configurations automatically
        MIGRATED=false

        # Fix old port (8081 → 80)
        if grep -q "BACKEND_PORT=8081" "$CONFIG_FILE" 2>/dev/null; then
            sed -i "s/BACKEND_PORT=8081/BACKEND_PORT=80/" "$CONFIG_FILE"
            echo "✅ Migrated BACKEND_PORT: 8081 → 80"
            MIGRATED=true
        fi

        # Fix old postgres path (./data/postgres → postgres) - CRITICAL FIX
        if grep -q "POSTGRES_DATA_DIR=./data/postgres" "$CONFIG_FILE" 2>/dev/null; then
            sed -i "s|POSTGRES_DATA_DIR=./data/postgres|POSTGRES_DATA_DIR=postgres|" "$CONFIG_FILE"
            echo "✅ Migrated POSTGRES_DATA_DIR: ./data/postgres → postgres"
            MIGRATED=true
        fi

        # Fix unquoted cron expressions (causes app startup failure)
        if grep -q "^CLOUD_SYNC_CRON=[^']" "$CONFIG_FILE" 2>/dev/null; then
            sed -i "s/^CLOUD_SYNC_CRON=\(.*\)$/CLOUD_SYNC_CRON='\1'/" "$CONFIG_FILE"
            echo "✅ Fixed CLOUD_SYNC_CRON quotes"
            MIGRATED=true
        fi

        if grep -q "^UPDATE_CHECK_CRON=[^']" "$CONFIG_FILE" 2>/dev/null; then
            sed -i "s/^UPDATE_CHECK_CRON=\(.*\)$/UPDATE_CHECK_CRON='\1'/" "$CONFIG_FILE"
            echo "✅ Fixed UPDATE_CHECK_CRON quotes"
            MIGRATED=true
        fi

        # Add config version if missing
        if ! grep -q "CONFIG_VERSION" "$CONFIG_FILE" 2>/dev/null; then
            echo "" >> "$CONFIG_FILE"
            echo "# Configuration Version (for automatic migration)" >> "$CONFIG_FILE"
            echo "CONFIG_VERSION=1.0" >> "$CONFIG_FILE"
            MIGRATED=true
        fi

        if [ "$MIGRATED" = true ]; then
            echo "📦 Configuration migrated to latest version"
            # Reload after migration
            export $(grep -v '^#' "$CONFIG_FILE" | xargs)
        fi
    fi

    # Migrate postgres data from old location to new location (for user installations)
    if [[ "$DATA_DIR" == *"$HOME"* ]]; then
        OLD_POSTGRES="$DATA_DIR/data/postgres"
        NEW_POSTGRES="$DATA_DIR/postgres"

        # Check if OLD location has actual postgres data (check for base/ directory)
        # and NEW location either doesn't exist or doesn't have postgres data yet
        if [ -d "$OLD_POSTGRES/base" ]; then
            if [ ! -d "$NEW_POSTGRES/base" ]; then
                echo ""
                echo "📦 Migrating postgres data to correct location..."
                echo "   From: $OLD_POSTGRES"
                echo "   To:   $NEW_POSTGRES"

                # Backup NEW if it exists (empty database created by v0.1.46)
                if [ -d "$NEW_POSTGRES" ]; then
                    echo "   Backing up empty database created by previous version..."
                    mv "$NEW_POSTGRES" "$NEW_POSTGRES.backup.$(date +%Y%m%d_%H%M%S)" 2>/dev/null || true
                fi

                mkdir -p "$DATA_DIR"
                if mv "$OLD_POSTGRES" "$NEW_POSTGRES" 2>/dev/null; then
                    echo "✅ Database migrated successfully"
                    echo "   Your existing credentials and data are preserved"
                    # Clean up empty directory
                    rmdir "$DATA_DIR/data" 2>/dev/null || true
                else
                    echo "⚠️  Warning: Could not migrate database automatically"
                    echo "   Please manually move: $OLD_POSTGRES"
                    echo "   To: $NEW_POSTGRES"
                fi
                echo ""
            fi
        fi
    fi

    # Set defaults
    export BACKEND_PORT=${BACKEND_PORT:-80}
    export JAVA_OPTS=${JAVA_OPTS:--Xms256m -Xmx512m -XX:+UseG1GC}
    export SPRING_PROFILES_ACTIVE=embedded
}

# Function to create data directories
create_data_dirs() {
    mkdir -p "$DATA_DIR/h2"
    mkdir -p "$DATA_DIR/uploads"
    mkdir -p "$DATA_DIR/logs"
    mkdir -p "$DATA_DIR/backups"
}

# Function to check if application is already running
check_running() {
    PID_FILE="$(dirname "$DATA_DIR")/shop-manager.pid"

    if [ -f "$PID_FILE" ]; then
        OLD_PID=$(cat "$PID_FILE")
        if ps -p "$OLD_PID" > /dev/null 2>&1; then
            # Construct URL
            CUSTOM_DOMAIN=${CUSTOM_DOMAIN:-localhost}
            if [ "$BACKEND_PORT" = "80" ]; then
                APP_URL="http://$CUSTOM_DOMAIN"
            else
                APP_URL="http://$CUSTOM_DOMAIN:$BACKEND_PORT"
            fi
            echo "Shop Manager is already running (PID: $OLD_PID)"
            echo "Access it at: $APP_URL"
            exit 0
        else
            rm "$PID_FILE"
        fi
    fi
}

# Function to cleanup zombie postgres processes
cleanup_postgres() {
    # Kill any zombie postgres processes on embedded port 5433
    # This prevents port conflicts and file permission errors
    POSTGRES_PORT=${POSTGRES_PORT:-5433}

    POSTGRES_PIDS=$(lsof -ti :$POSTGRES_PORT 2>/dev/null || fuser $POSTGRES_PORT/tcp 2>/dev/null || true)
    if [ -n "$POSTGRES_PIDS" ]; then
        echo "⚠️  Found zombie postgres process(es) on port $POSTGRES_PORT"
        echo "Stopping old postgres instances..."
        for pid in $POSTGRES_PIDS; do
            kill -9 $pid 2>/dev/null || true
        done
        sleep 2
        echo "✅ Old postgres processes stopped"
    fi

    # Also clean up any stale lock files
    if [ -d "$DATA_DIR/postgres" ]; then
        find "$DATA_DIR/postgres" -name "*.lock" -delete 2>/dev/null || true
        find "$DATA_DIR/postgres" -name ".s.PGSQL.*" -delete 2>/dev/null || true
    fi
}

# Function to find JAR file
find_jar() {
    if [ -f "/opt/shop-manager/lib/shop-manager.jar" ]; then
        echo "/opt/shop-manager/lib/shop-manager.jar"
    elif [ -f "$APP_DIR/lib/shop-manager.jar" ]; then
        echo "$APP_DIR/lib/shop-manager.jar"
    elif [ -f "$APP_DIR/usr/lib/shop-manager/shop-manager.jar" ]; then
        echo "$APP_DIR/usr/lib/shop-manager/shop-manager.jar"
    else
        echo "ERROR: Could not find shop-manager.jar"
        exit 1
    fi
}

# Function to start application
start_application() {
    JAR_FILE=$(find_jar)

    # Change to data directory
    cd "$DATA_DIR"

    echo "Starting Shop Manager..."
    echo "  Java Version: $(java -version 2>&1 | head -1)"
    echo "  JAR File: $JAR_FILE"
    echo "  Data Directory: $DATA_DIR"
    echo "  Backend Port: $BACKEND_PORT"
    echo ""

    # Start application
    java $JAVA_OPTS \
        -Dspring.profiles.active=embedded \
        -Dserver.port=$BACKEND_PORT \
        -Dapplication.jwt.secret="$JWT_SECRET" \
        -Dapplication.sync.enabled="${CLOUD_SYNC_ENABLED:-false}" \
        -Dapplication.sync.cloud-endpoint="$CLOUD_API_URL" \
        -Dapplication.sync.api-key="$CLOUD_API_KEY" \
        -Dapplication.sync.store-id="$STORE_ID" \
        -jar "$JAR_FILE" \
        > "$LOG_FILE" 2>&1 &

    # Save PID
    echo $! > "$(dirname "$DATA_DIR")/shop-manager.pid"

    echo "Shop Manager starting..."
    echo "Waiting for startup..."
    sleep 5

    # Construct application URL
    CUSTOM_DOMAIN=${CUSTOM_DOMAIN:-localhost}
    if [ "$BACKEND_PORT" = "80" ]; then
        APP_URL="http://$CUSTOM_DOMAIN"
    else
        APP_URL="http://$CUSTOM_DOMAIN:$BACKEND_PORT"
    fi

    # Check if application started
    if curl -s "$APP_URL/actuator/health" > /dev/null 2>&1; then
        echo ""
        echo "✓ Shop Manager started successfully!"
        echo ""
        echo "Access the application at: $APP_URL"
        echo "Logs: $LOG_FILE"
        echo ""

        # Try to open browser
        if command -v xdg-open &> /dev/null; then
            xdg-open "$APP_URL" &
        fi
    else
        echo ""
        echo "WARNING: Shop Manager may still be starting..."
        echo "Check logs: tail -f $LOG_FILE"
        echo ""
    fi
}

# Main execution
main() {
    check_java
    load_env
    create_data_dirs
    check_running
    cleanup_postgres
    start_application
}

# Run main
main
