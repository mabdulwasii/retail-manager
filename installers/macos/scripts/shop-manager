#!/bin/bash
# ============================================================================
# Shop Manager - macOS Launcher Script
# ============================================================================
# This script launches Shop Manager on macOS
# ============================================================================

# Get the directory where the app bundle is located
APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../Resources" && pwd)"

# Function to check Java installation
check_java() {
    if ! command -v java &> /dev/null; then
        osascript -e 'display dialog "Java 21 or higher is required to run Shop Manager.\n\nPlease download and install Java from:\nhttps://adoptium.net/temurin/releases/?version=21" buttons {"OK"} default button "OK" with icon stop with title "Shop Manager - Java Required"'
        exit 1
    fi

    # Check Java version
    JAVA_VERSION=$(java -version 2>&1 | head -1 | cut -d'"' -f2 | cut -d'.' -f1)
    if [ "$JAVA_VERSION" -lt 21 ]; then
        osascript -e 'display dialog "Shop Manager requires Java 21 or higher.\n\nCurrent version: Java '"$JAVA_VERSION"'\n\nPlease download and install Java 21 from:\nhttps://adoptium.net/temurin/releases/?version=21" buttons {"OK"} default button "OK" with icon stop with title "Shop Manager - Java Update Required"'
        exit 1
    fi
}

# Function to load environment variables
load_env() {
    ENV_FILE="$HOME/.shopmanager/.env"

    # Create config directory if it doesn't exist
    mkdir -p "$HOME/.shopmanager"

    # Copy template if .env doesn't exist
    if [ ! -f "$ENV_FILE" ]; then
        cp "$APP_DIR/config/.env.template" "$ENV_FILE"

        # Generate JWT secret
        JWT_SECRET=$(openssl rand -base64 64 | tr -d '\n')
        sed -i '' "s|JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET|JWT_SECRET=$JWT_SECRET|" "$ENV_FILE"

        # Set permissions
        chmod 600 "$ENV_FILE"
    fi

    # Load environment variables
    export $(grep -v '^#' "$ENV_FILE" | xargs)

    # Set defaults
    export BACKEND_PORT=${BACKEND_PORT:-8081}
    export JAVA_OPTS=${JAVA_OPTS:--Xms256m -Xmx512m -XX:+UseG1GC}
    export SPRING_PROFILES_ACTIVE=embedded
}

# Function to create data directories
create_data_dirs() {
    mkdir -p "$HOME/.shopmanager/data/h2"
    mkdir -p "$HOME/.shopmanager/data/uploads"
    mkdir -p "$HOME/.shopmanager/data/logs"
    mkdir -p "$HOME/.shopmanager/data/backups"
}

# Function to check if application is already running
check_running() {
    PID_FILE="$HOME/.shopmanager/shop-manager.pid"

    if [ -f "$PID_FILE" ]; then
        OLD_PID=$(cat "$PID_FILE")
        if ps -p "$OLD_PID" > /dev/null 2>&1; then
            # Ask user if they want to restart
            RESPONSE=$(osascript -e 'display dialog "Shop Manager is already running at:\nhttp://localhost:'"$BACKEND_PORT"'\n\nDo you want to restart it?" buttons {"Cancel", "Access Current", "Restart"} default button "Access Current" with icon note with title "Shop Manager"' 2>&1)

            if [[ "$RESPONSE" == *"Restart"* ]]; then
                # Stop the existing instance
                kill "$OLD_PID" 2>/dev/null
                sleep 2
                # Force kill if still running
                if ps -p "$OLD_PID" > /dev/null 2>&1; then
                    kill -9 "$OLD_PID" 2>/dev/null
                    sleep 1
                fi
                rm "$PID_FILE"
            elif [[ "$RESPONSE" == *"Access Current"* ]]; then
                # Open browser to existing instance
                open "http://localhost:$BACKEND_PORT"
                exit 0
            else
                # User cancelled
                exit 0
            fi
        else
            # Stale PID file
            rm "$PID_FILE"
        fi
    fi
}

# Function to check if ports are available
check_ports() {
    if lsof -i ":$BACKEND_PORT" -sTCP:LISTEN -t >/dev/null 2>&1; then
        RESPONSE=$(osascript -e 'display dialog "Port '"$BACKEND_PORT"' is already in use by another application.\n\nThis may be an old Shop Manager instance.\nWould you like to attempt to stop it?" buttons {"Cancel", "Stop Old Instance"} default button "Stop Old Instance" with icon caution with title "Shop Manager - Port Conflict"' 2>&1)

        if [[ "$RESPONSE" == *"Stop Old Instance"* ]]; then
            # Run pre-install stop script
            if [ -f "$APP_DIR/../MacOS/../Resources/../MacOS/../Resources/../../scripts/pre-install-stop.sh" ]; then
                bash "$APP_DIR/../scripts/pre-install-stop.sh"
            else
                # Manual cleanup if script not found
                pkill -9 -f "shop-manager.*\.jar" 2>/dev/null || true
                sleep 2
            fi

            # Check again
            if lsof -i ":$BACKEND_PORT" -sTCP:LISTEN -t >/dev/null 2>&1; then
                osascript -e 'display dialog "Failed to free port '"$BACKEND_PORT"'.\n\nPlease manually stop the application using that port." buttons {"OK"} default button "OK" with icon stop with title "Shop Manager - Error"'
                exit 1
            fi
        else
            exit 1
        fi
    fi
}

# Function to start application
start_application() {
    # Find all JAR files and pick the highest version (use mapfile for proper space handling)
    mapfile -t JAR_FILES < <(find "$APP_DIR" -name "shop-manager-*-embedded.jar" | sort -r)
    JAR_COUNT=${#JAR_FILES[@]}

    if [ "$JAR_COUNT" -eq 0 ]; then
        osascript -e 'display dialog "Shop Manager JAR file not found in:\n'"$APP_DIR"'\n\nExpected: shop-manager-*-embedded.jar" buttons {"OK"} default button "OK" with icon stop with title "Shop Manager - Error"'
        exit 1
    fi

    # Use the first (highest version) JAR
    JAR_FILE="${JAR_FILES[0]}"
    JAR_BASENAME="$(basename "$JAR_FILE")"

    # Warn if multiple JARs found
    if [ "$JAR_COUNT" -gt 1 ]; then
        osascript -e "display dialog \"Warning: Found $JAR_COUNT JAR files.\n\nUsing latest:\n$JAR_BASENAME\n\nThis may indicate an incomplete upgrade.\nConsider reinstalling Shop Manager.\" buttons {\"Continue\"} default button \"Continue\" with icon caution with title \"Shop Manager - Multiple Versions\"" &
        # Don't wait for user to dismiss - continue launching
    fi

    LOG_FILE="$HOME/.shopmanager/data/logs/shop-manager.log"
    echo "=========================================" > "$LOG_FILE"
    echo "Shop Manager Starting: $(date)" >> "$LOG_FILE"
    echo "JAR: $JAR_FILE" >> "$LOG_FILE"
    echo "=========================================" >> "$LOG_FILE"

    # Change to user's data directory
    cd "$HOME/.shopmanager/data"

    # Start application in background (quote all variables properly)
    java $JAVA_OPTS \
        -Dspring.profiles.active=embedded \
        -Dserver.port="$BACKEND_PORT" \
        -Dapplication.jwt.secret="$JWT_SECRET" \
        -Dapplication.sync.enabled="${CLOUD_SYNC_ENABLED:-false}" \
        -Dapplication.sync.cloud-endpoint="$CLOUD_API_URL" \
        -Dapplication.sync.api-key="$CLOUD_API_KEY" \
        -Dapplication.sync.store-id="$STORE_ID" \
        -Dspring.config.additional-location="file:$APP_DIR/config/application.yml" \
        -jar "$JAR_FILE" \
        >> "$LOG_FILE" 2>&1 &

    # Save PID
    APP_PID=$!
    echo $APP_PID > "$HOME/.shopmanager/shop-manager.pid"

    # Wait for startup with timeout
    echo "Waiting for Shop Manager to start (PID: $APP_PID)..." >> "$LOG_FILE"
    for i in {1..30}; do
        sleep 1

        # Check if process is still running
        if ! ps -p $APP_PID > /dev/null 2>&1; then
            # Get last 20 lines of log for error
            TAIL_LOG=$(tail -n 20 "$LOG_FILE")
            osascript -e 'display dialog "Shop Manager process terminated unexpectedly.\n\nRecent log:\n'"$(echo "$TAIL_LOG" | head -n 5 | tr '\n' ' ')"'\n\nFull log at:\n'"$LOG_FILE"'" buttons {"OK"} default button "OK" with icon stop with title "Shop Manager - Error"'
            exit 1
        fi

        # Check if health endpoint is responding
        if curl -s http://localhost:$BACKEND_PORT/actuator/health > /dev/null 2>&1; then
            echo "✅ Shop Manager started successfully" >> "$LOG_FILE"
            # Open browser
            open "http://localhost:$BACKEND_PORT"
            osascript -e 'display notification "Shop Manager started successfully" with title "Shop Manager" sound name "Glass"'
            return 0
        fi
    done

    # Timeout - failed to start
    TAIL_LOG=$(tail -n 30 "$LOG_FILE")
    osascript -e 'display dialog "Shop Manager failed to start within 30 seconds.\n\nThe application may still be initializing.\nCheck:\n'"$LOG_FILE"'\n\nProcess (PID '"$APP_PID"') is still running." buttons {"OK"} default button "OK" with icon caution with title "Shop Manager - Startup Timeout"'
}

# Main execution
main() {
    check_java
    load_env
    create_data_dirs
    check_running
    check_ports
    start_application
}

# Run main
main
