#!/bin/bash
# ============================================================================
# Shop Manager - macOS Launcher Script
# ============================================================================
# This script launches Shop Manager on macOS
# ============================================================================

# Get the directory where the app bundle is located
APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../Resources" && pwd)"

# Function to check Java installation
check_java() {
    if ! command -v java &> /dev/null; then
        osascript -e 'display dialog "Java 21 or higher is required to run Shop Manager.\n\nPlease download and install Java from:\nhttps://adoptium.net/temurin/releases/?version=21" buttons {"OK"} default button "OK" with icon stop with title "Shop Manager - Java Required"'
        exit 1
    fi

    # Check Java version
    JAVA_VERSION=$(java -version 2>&1 | head -1 | cut -d'"' -f2 | cut -d'.' -f1)
    if [ "$JAVA_VERSION" -lt 21 ]; then
        osascript -e 'display dialog "Shop Manager requires Java 21 or higher.\n\nCurrent version: Java '"$JAVA_VERSION"'\n\nPlease download and install Java 21 from:\nhttps://adoptium.net/temurin/releases/?version=21" buttons {"OK"} default button "OK" with icon stop with title "Shop Manager - Java Update Required"'
        exit 1
    fi
}

# Function to load environment variables
load_env() {
    ENV_FILE="$HOME/.shopmanager/.env"

    # Create config directory if it doesn't exist
    mkdir -p "$HOME/.shopmanager"

    # Copy template if .env doesn't exist
    if [ ! -f "$ENV_FILE" ]; then
        cp "$APP_DIR/config/.env.template" "$ENV_FILE"

        # Generate JWT secret
        JWT_SECRET=$(openssl rand -base64 64 | tr -d '\n')
        sed -i '' "s|JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET|JWT_SECRET=$JWT_SECRET|" "$ENV_FILE"

        # Set permissions
        chmod 600 "$ENV_FILE"
    fi

    # Check if .env is old format (missing POSTGRES_DATA_DIR)
    if ! grep -q "POSTGRES_DATA_DIR" "$ENV_FILE" 2>/dev/null; then
        echo ""
        echo "📦 Detected old configuration format (v0.1.30)"
        echo "   Migrating to new format with embedded PostgreSQL..."

        # Backup old .env
        cp "$ENV_FILE" "$ENV_FILE.backup.$(date +%Y%m%d_%H%M%S)"
        echo "   Backed up old config to: $ENV_FILE.backup.*"

        # Copy new template
        cp "$APP_DIR/config/.env.template" "$ENV_FILE"
        echo "   Created new configuration with PostgreSQL settings"

        # Generate new JWT secret
        JWT_SECRET=$(openssl rand -base64 64 | tr -d '\n')
        sed -i '' "s|JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET|JWT_SECRET=$JWT_SECRET|" "$ENV_FILE"

        # Set permissions
        chmod 600 "$ENV_FILE"
        echo "✅ Configuration upgraded to v0.1.49 format"
        echo "   NOTE: You will need to log in again with your credentials"
        echo ""
    fi

    # Load environment variables using safe method (handles spaces in values)
    set -a
    source "$ENV_FILE" 2>/dev/null || true
    set +a

    # Migrate old configurations automatically
    MIGRATED=false

    # Fix old port (8081 → 80)
    if grep -q "BACKEND_PORT=8081" "$ENV_FILE" 2>/dev/null; then
        sed -i '' "s/BACKEND_PORT=8081/BACKEND_PORT=80/" "$ENV_FILE"
        echo "✅ Migrated BACKEND_PORT: 8081 → 80"
        MIGRATED=true
    fi

    # Fix old postgres path (./data/postgres → postgres) - CRITICAL FIX
    if grep -q "POSTGRES_DATA_DIR=./data/postgres" "$ENV_FILE" 2>/dev/null; then
        sed -i '' "s|POSTGRES_DATA_DIR=./data/postgres|POSTGRES_DATA_DIR=postgres|" "$ENV_FILE"
        echo "✅ Migrated POSTGRES_DATA_DIR: ./data/postgres → postgres"
        MIGRATED=true
    fi

    # Add config version if missing
    if ! grep -q "CONFIG_VERSION" "$ENV_FILE" 2>/dev/null; then
        echo "" >> "$ENV_FILE"
        echo "# Configuration Version (for automatic migration)" >> "$ENV_FILE"
        echo "CONFIG_VERSION=1.0" >> "$ENV_FILE"
        MIGRATED=true
    fi

    if [ "$MIGRATED" = true ]; then
        echo "📦 Configuration migrated to latest version"
        # Reload after migration
        set -a
        source "$ENV_FILE" 2>/dev/null || true
        set +a
    fi

    # Migrate postgres data from old location to new location
    OLD_POSTGRES="$HOME/.shopmanager/data/data/postgres"
    NEW_POSTGRES="$HOME/.shopmanager/data/postgres"

    # Check if OLD location has actual postgres data (check for base/ directory)
    # and NEW location either doesn't exist or doesn't have postgres data yet
    if [ -d "$OLD_POSTGRES/base" ]; then
        if [ ! -d "$NEW_POSTGRES/base" ]; then
            echo ""
            echo "📦 Migrating postgres data to correct location..."
            echo "   From: $OLD_POSTGRES"
            echo "   To:   $NEW_POSTGRES"

            # Backup NEW if it exists (empty database created by v0.1.46)
            if [ -d "$NEW_POSTGRES" ]; then
                echo "   Backing up empty database created by previous version..."
                mv "$NEW_POSTGRES" "$NEW_POSTGRES.backup.$(date +%Y%m%d_%H%M%S)" 2>/dev/null || true
            fi

            mkdir -p "$HOME/.shopmanager/data"
            if mv "$OLD_POSTGRES" "$NEW_POSTGRES" 2>/dev/null; then
                echo "✅ Database migrated successfully"
                echo "   Your existing credentials and data are preserved"
                # Clean up empty directory
                rmdir "$HOME/.shopmanager/data/data" 2>/dev/null || true
            else
                echo "⚠️  Warning: Could not migrate database automatically"
                echo "   Please manually move: $OLD_POSTGRES"
                echo "   To: $NEW_POSTGRES"
            fi
            echo ""
        fi
    fi

    # Set defaults
    export BACKEND_PORT=${BACKEND_PORT:-80}
    export JAVA_OPTS=${JAVA_OPTS:--Xms256m -Xmx512m -XX:+UseG1GC}
    export SPRING_PROFILES_ACTIVE=embedded
}

# Function to create data directories
create_data_dirs() {
    mkdir -p "$HOME/.shopmanager/data/h2"
    mkdir -p "$HOME/.shopmanager/data/uploads"
    mkdir -p "$HOME/.shopmanager/data/logs"
    mkdir -p "$HOME/.shopmanager/data/backups"
}

# Function to check if application is already running
check_running() {
    PID_FILE="$HOME/.shopmanager/shop-manager.pid"

    if [ -f "$PID_FILE" ]; then
        OLD_PID=$(cat "$PID_FILE")
        if ps -p "$OLD_PID" > /dev/null 2>&1; then
            # Ask user if they want to restart
            RESPONSE=$(osascript -e 'display dialog "Shop Manager is already running at:\nhttp://localhost:'"$BACKEND_PORT"'\n\nDo you want to restart it?" buttons {"Cancel", "Access Current", "Restart"} default button "Access Current" with icon note with title "Shop Manager"' 2>&1)

            if [[ "$RESPONSE" == *"Restart"* ]]; then
                # Stop the existing instance
                kill "$OLD_PID" 2>/dev/null
                sleep 2
                # Force kill if still running
                if ps -p "$OLD_PID" > /dev/null 2>&1; then
                    kill -9 "$OLD_PID" 2>/dev/null
                    sleep 1
                fi
                rm "$PID_FILE"
            elif [[ "$RESPONSE" == *"Access Current"* ]]; then
                # Open browser to existing instance
                open "http://localhost:$BACKEND_PORT"
                exit 0
            else
                # User cancelled
                exit 0
            fi
        else
            # Stale PID file
            rm "$PID_FILE"
        fi
    fi
}

# Function to check if ports are available
check_ports() {
    if lsof -i ":$BACKEND_PORT" -sTCP:LISTEN -t >/dev/null 2>&1; then
        RESPONSE=$(osascript -e 'display dialog "Port '"$BACKEND_PORT"' is already in use by another application.\n\nThis may be an old Shop Manager instance.\nWould you like to attempt to stop it?" buttons {"Cancel", "Stop Old Instance"} default button "Stop Old Instance" with icon caution with title "Shop Manager - Port Conflict"' 2>&1)

        if [[ "$RESPONSE" == *"Stop Old Instance"* ]]; then
            # Run pre-install stop script
            if [ -f "$APP_DIR/../MacOS/../Resources/../MacOS/../Resources/../../scripts/pre-install-stop.sh" ]; then
                bash "$APP_DIR/../scripts/pre-install-stop.sh"
            else
                # Manual cleanup if script not found
                pkill -9 -f "shop-manager.*\.jar" 2>/dev/null || true
                sleep 2
            fi

            # Check again
            if lsof -i ":$BACKEND_PORT" -sTCP:LISTEN -t >/dev/null 2>&1; then
                osascript -e 'display dialog "Failed to free port '"$BACKEND_PORT"'.\n\nPlease manually stop the application using that port." buttons {"OK"} default button "OK" with icon stop with title "Shop Manager - Error"'
                exit 1
            fi
        else
            exit 1
        fi
    fi
}

# Function to cleanup zombie postgres processes
cleanup_postgres() {
    # Kill any zombie postgres processes on embedded port 5433
    # This prevents port conflicts and file permission errors
    POSTGRES_PORT=${POSTGRES_PORT:-5433}

    POSTGRES_PIDS=$(lsof -ti :$POSTGRES_PORT 2>/dev/null || true)
    if [ -n "$POSTGRES_PIDS" ]; then
        echo "⚠️  Found zombie postgres process(es) on port $POSTGRES_PORT"
        echo "Stopping old postgres instances..."
        for pid in $POSTGRES_PIDS; do
            kill -9 $pid 2>/dev/null || true
        done
        sleep 2
        echo "✅ Old postgres processes stopped"
    fi

    # Also clean up any stale lock files
    if [ -d "$HOME/.shopmanager/data/postgres" ]; then
        find "$HOME/.shopmanager/data/postgres" -name "*.lock" -delete 2>/dev/null || true
        find "$HOME/.shopmanager/data/postgres" -name ".s.PGSQL.*" -delete 2>/dev/null || true
    fi
}

# Function to start application
start_application() {
    # Debug: Log directory contents
    LOG_FILE="$HOME/.shopmanager/data/logs/shop-manager.log"
    mkdir -p "$(dirname "$LOG_FILE")"
    echo "=========================================" > "$LOG_FILE"
    echo "Shop Manager Launcher Debug" >> "$LOG_FILE"
    echo "Date: $(date)" >> "$LOG_FILE"
    echo "=========================================" >> "$LOG_FILE"
    echo "APP_DIR: $APP_DIR" >> "$LOG_FILE"
    echo "" >> "$LOG_FILE"
    echo "Contents of APP_DIR:" >> "$LOG_FILE"
    ls -la "$APP_DIR" >> "$LOG_FILE" 2>&1
    echo "" >> "$LOG_FILE"
    echo "Searching for: shop-manager-*-embedded.jar" >> "$LOG_FILE"
    find "$APP_DIR" -name "shop-manager-*-embedded.jar" >> "$LOG_FILE" 2>&1
    echo "=========================================" >> "$LOG_FILE"

    # Find all JAR files and pick the highest version
    # Use bash 3.2 compatible approach (macOS default bash is 3.2)
    # Sort by version number properly (semantic versioning aware)
    JAR_FILES=()
    while IFS= read -r jar; do
        JAR_FILES+=("$jar")
    done < <(find "$APP_DIR" -name "shop-manager-*-embedded.jar" | sort -t'-' -k2 -V -r 2>/dev/null || find "$APP_DIR" -name "shop-manager-*-embedded.jar" | sort -r)
    JAR_COUNT=${#JAR_FILES[@]}

    if [ "$JAR_COUNT" -eq 0 ]; then
        # Enhanced error message with debug info
        ALL_JARS=$(find "$APP_DIR" -name "*.jar" 2>/dev/null || echo "No JAR files found")
        osascript -e 'display dialog "Shop Manager JAR file not found in:\n'"$APP_DIR"'\n\nExpected: shop-manager-*-embedded.jar\n\nFound JARs:\n'"$ALL_JARS"'\n\nSee log: '"$LOG_FILE"'" buttons {"OK"} default button "OK" with icon stop with title "Shop Manager - Error"'
        exit 1
    fi

    # Use the first (highest version) JAR
    JAR_FILE="${JAR_FILES[0]}"
    JAR_BASENAME="$(basename "$JAR_FILE")"

    # Clean up old JAR files if multiple versions found
    if [ "$JAR_COUNT" -gt 1 ]; then
        echo "⚠️  WARNING: Found $JAR_COUNT JAR files!" | tee -a "$LOG_FILE"
        echo "Cleaning up old versions..." | tee -a "$LOG_FILE"
        echo "" >> "$LOG_FILE"
        echo "All JARs found:" >> "$LOG_FILE"
        for jar in "${JAR_FILES[@]}"; do
            echo "  - $(basename "$jar")" >> "$LOG_FILE"
        done
        echo "" >> "$LOG_FILE"
        echo "Keeping newest: $JAR_BASENAME" | tee -a "$LOG_FILE"

        # Keep only the newest JAR (first in sorted array)
        for ((i=1; i<JAR_COUNT; i++)); do
            OLD_JAR="${JAR_FILES[$i]}"
            OLD_JAR_NAME="$(basename "$OLD_JAR")"
            echo "Removing old JAR: $OLD_JAR_NAME" | tee -a "$LOG_FILE"
            if rm -f "$OLD_JAR"; then
                echo "  ✅ Deleted: $OLD_JAR_NAME" >> "$LOG_FILE"
            else
                echo "  ❌ Failed to delete: $OLD_JAR_NAME" >> "$LOG_FILE"
            fi
        done
        echo "✅ Cleanup complete" | tee -a "$LOG_FILE"
        echo ""
    fi

    # Log startup info (log file already created above with debug info)
    echo "" >> "$LOG_FILE"
    echo "Starting application..." >> "$LOG_FILE"
    echo "JAR File: $JAR_FILE" >> "$LOG_FILE"
    echo "JAR Count: $JAR_COUNT" >> "$LOG_FILE"
    echo "=========================================" >> "$LOG_FILE"

    # Change to user's data directory
    cd "$HOME/.shopmanager/data"

    # Bootstrap diagnostic - show user what to expect
    POSTGRES_PATH="$HOME/.shopmanager/data/postgres"
    if [ -d "$POSTGRES_PATH/base" ]; then
        echo "" | tee -a "$LOG_FILE"
        echo "ℹ️  Using existing database" | tee -a "$LOG_FILE"
        echo "   Location: $POSTGRES_PATH" | tee -a "$LOG_FILE"
        echo "   Note: Login with your existing credentials" | tee -a "$LOG_FILE"
        echo "" | tee -a "$LOG_FILE"
    else
        echo "" | tee -a "$LOG_FILE"
        echo "✅ Fresh installation - creating superadmin account" | tee -a "$LOG_FILE"
        echo "   Username: superadmin@retailhq.local" | tee -a "$LOG_FILE"
        echo "   Password: changeme" | tee -a "$LOG_FILE"
        echo "   (Change password after first login)" | tee -a "$LOG_FILE"
        echo "" | tee -a "$LOG_FILE"
    fi

    # Start application in background (quote all variables properly)
    java $JAVA_OPTS \
        -Dspring.profiles.active=embedded \
        -Dserver.port="$BACKEND_PORT" \
        -Dapplication.jwt.secret="$JWT_SECRET" \
        -Dapplication.sync.enabled="${CLOUD_SYNC_ENABLED:-false}" \
        -Dapplication.sync.cloud-endpoint="$CLOUD_API_URL" \
        -Dapplication.sync.api-key="$CLOUD_API_KEY" \
        -Dapplication.sync.store-id="$STORE_ID" \
        -Dspring.config.additional-location="file:$APP_DIR/config/application.yml" \
        -jar "$JAR_FILE" \
        >> "$LOG_FILE" 2>&1 &

    # Save PID
    APP_PID=$!
    echo $APP_PID > "$HOME/.shopmanager/shop-manager.pid"

    # Wait for startup with timeout
    echo "Waiting for Shop Manager to start (PID: $APP_PID)..." >> "$LOG_FILE"
    for i in {1..30}; do
        sleep 1

        # Check if process is still running
        if ! ps -p $APP_PID > /dev/null 2>&1; then
            # Get last 20 lines of log for error
            TAIL_LOG=$(tail -n 20 "$LOG_FILE")
            osascript -e 'display dialog "Shop Manager process terminated unexpectedly.\n\nRecent log:\n'"$(echo "$TAIL_LOG" | head -n 5 | tr '\n' ' ')"'\n\nFull log at:\n'"$LOG_FILE"'" buttons {"OK"} default button "OK" with icon stop with title "Shop Manager - Error"'
            exit 1
        fi

        # Construct application URL
        CUSTOM_DOMAIN=${CUSTOM_DOMAIN:-localhost}
        if [ "$BACKEND_PORT" = "80" ]; then
            APP_URL="http://$CUSTOM_DOMAIN"
        else
            APP_URL="http://$CUSTOM_DOMAIN:$BACKEND_PORT"
        fi

        # Check if health endpoint is responding
        if curl -s "$APP_URL/actuator/health" > /dev/null 2>&1; then
            echo "✅ Shop Manager started successfully" >> "$LOG_FILE"
            echo "   URL: $APP_URL" >> "$LOG_FILE"
            # Open browser
            open "$APP_URL"
            osascript -e 'display notification "Shop Manager started at '"$APP_URL"'" with title "Shop Manager" sound name "Glass"'
            return 0
        fi
    done

    # Timeout - failed to start
    TAIL_LOG=$(tail -n 30 "$LOG_FILE")
    osascript -e 'display dialog "Shop Manager failed to start within 30 seconds.\n\nThe application may still be initializing.\nCheck:\n'"$LOG_FILE"'\n\nProcess (PID '"$APP_PID"') is still running." buttons {"OK"} default button "OK" with icon caution with title "Shop Manager - Startup Timeout"'
}

# Main execution
main() {
    check_java
    load_env
    create_data_dirs
    check_running
    check_ports
    cleanup_postgres
    start_application
}

# Run main
main
